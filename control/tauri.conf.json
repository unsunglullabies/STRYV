{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STRYV Control",
  "identifier": "app.stryv.control",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../control/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "STRYV Control",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": []
  }
}