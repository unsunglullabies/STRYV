{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STRYV Test",
  "mainBinaryName": "stryv-test",
  "identifier": "app.stryv.desktop.test",
  "version": "0.2.9",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "STRYV Test",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": []
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}